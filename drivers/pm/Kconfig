# Power Management Driver configuration options

# Copyright (c) 2026 Scott King
# SPDX-License-Identifier: Apache-2.0

menuconfig PM_DRIVERS
	bool "Power Management Drivers"
	help
	  Enable support for Power Management Drivers.

if PM_DRIVERS

config PM_WCH
	bool "WCH Power Management [PWR] driver"
	default y
	depends on DT_HAS_WCH_PWR_ENABLED
	help
	  Enable support for the WCH Power Management [PWR] driver.

config PM_WCH_INIT_PRIORITY
	int "WCH PWR driver initialization priority"
	default 40
	depends on PM_WCH
	help
	  Initialization priority for the WCH PWR driver.

endif # PM_DRIVERS
