/dts-v1/;

#include <wch/ch32l103/ch32l103.dtsi>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "ch32l103_evt-pinctrl.dtsi"

/ {
	model = "WCH CH32L103 Evaluation Board";
	compatible = "wch,ch32l103-evt";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	leds {
		compatible = "gpio-leds";
		blue_led: led_0 {
			gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
			label = "PA8 LED";
		};
	};

	aliases {
		led0 = &blue_led;
		pwm-led0 = &pwm_led0;
	};

	pwmleds {
		compatible = "pwm-leds";
		pwm_led0: pwm_led_0 {
			pwms = <&pwm1 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};
};

&clk_hsi {
	status = "okay";
};

&pll {
	status = "okay";
	clocks = <&clk_hsi>;
	mul = <18>;
};

&usart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&usart1_default>;
	pinctrl-names = "default";
	dmas = <&dma1 3>, <&dma1 4>;
	dma-names = "tx", "rx";
};

&gpioa {
	status = "okay";
};

&rcc {
	status = "okay";
	clocks = <&pll>;
};

zephyr_udc0: &usbfs {
	status = "okay";
	pinctrl-0 = <&usbfs_default>;
	pinctrl-names = "default";
};

&usbpd {
    status = "okay";
    pinctrl-0 = <&usbpd_default>;
    pinctrl-names = "default";
};

&adc1 {
    status = "okay";
    pinctrl-0 = <&adc1_default>;
    pinctrl-names = "default";
};

&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_default>;
    pinctrl-names = "default";
    dmas = <&dma1 2>, <&dma1 1>;
    dma-names = "tx", "rx";
};

&cpu0 {
	clock-frequency = <72000000>;
};

&i2c1 {
    status = "okay";
    pinctrl-0 = <&i2c1_default>;
    pinctrl-names = "default";
    clock-frequency = <48000000>;
    dmas = <&dma1 5>, <&dma1 6>;
    dma-names = "tx", "rx";
};

&opacmp {
	status = "okay";
};

&opa1 {
	status = "okay";
};

&cmp1 {
	status = "okay";
};

&tim1 {
	status = "okay";
	channels = <4>;
	pwm1: pwm {
		compatible = "wch,gptm-pwm";
		status = "okay";
		#pwm-cells = <3>;
		pinctrl-0 = <&tim1_default>;
		pinctrl-names = "default";
	};
};
&iwdg { status = "okay"; };
&wwdg { status = "okay"; };
&bkp { status = "okay"; };
&rtc { status = "okay"; };
